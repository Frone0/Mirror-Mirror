--- !u!114 &210745445
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 210745440}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8eb9b45d9fbe34542a28a2ee769f42e1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TrainingMode
  gameFlow: {fileID: 210745441}
  gm: {fileID: 210745443}
  NPC: {fileID: 1191675097}
  InstructionText: {fileID: 187317208}
  StartPanel: {fileID: 1604591549}
  TimePerLevel: 4
  PauseBetweenLevels: 1
  EndMessageTime: 2.5
  Levels:
  - Instruction: 'Hold the pose until the timer ends.

      He stands still - just
      do nothing!'
    InstructionRu: "\u0414\u0435\u0440\u0436\u0438 \u043F\u043E\u0437\u0443, \u043F\u043E\u043A\u0430
      \u043D\u0435 \u043A\u043E\u043D\u0447\u0438\u0442\u0441\u044F \u0442\u0430\u0439\u043C\u0435\u0440.\n\u041E\u043D
      \u0441\u0442\u043E\u0438\u0442 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E
      - \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0434\u0435\u043B\u0430\u0439!"
    Mode: 0
    Pose:
      RightHandIsUp: 0
      LeftHandIsUp: 0
      IsStanding: 1
      Jumped: 0
  - Instruction: 'He raised a hand.

      Hold <color=#FFD040>A</color> to copy
      him!'
    InstructionRu: "\u041E\u043D \u043F\u043E\u0434\u043D\u044F\u043B \u0440\u0443\u043A\u0443.\n\u0417\u0430\u0436\u043C\u0438
      <color=#FFD040>A</color>, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0432\u0442\u043E\u0440\u0438\u0442\u044C!"
    Mode: 0
    Pose:
      RightHandIsUp: 0
      LeftHandIsUp: 1
      IsStanding: 1
      Jumped: 0
  - Instruction: 'Other hand now.

      Hold <color=#FFD040>D</color>!'
    InstructionRu: "\u0422\u0435\u043F\u0435\u0440\u044C \u0434\u0440\u0443\u0433\u0430\u044F
      \u0440\u0443\u043A\u0430.\n\u0417\u0430\u0436\u043C\u0438 <color=#FFD040>D</color>!"
    Mode: 0
    Pose:
      RightHandIsUp: 1
      LeftHandIsUp: 0
      IsStanding: 1
      Jumped: 0
  - Instruction: 'Both hands up!

      Hold <color=#FFD040>A</color> + <color=#FFD040>D</color>'
    InstructionRu: "\u041E\u0431\u0435 \u0440\u0443\u043A\u0438 \u0432\u0432\u0435\u0440\u0445!\n\u0417\u0430\u0436\u043C\u0438
      <color=#FFD040>A</color> + <color=#FFD040>D</color>"
    Mode: 0
    Pose:
      RightHandIsUp: 1
      LeftHandIsUp: 1
      IsStanding: 1
      Jumped: 0
  - Instruction: 'He crouches.

      Hold <color=#FFD040>S</color> to crouch!'
    InstructionRu: "\u041E\u043D \u043F\u0440\u0438\u0441\u0435\u0434\u0430\u0435\u0442.\n\u0417\u0430\u0436\u043C\u0438
      <color=#FFD040>S</color>, \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u0438\u0441\u0435\u0441\u0442\u044C!"
    Mode: 0
    Pose:
      RightHandIsUp: 0
      LeftHandIsUp: 0
      IsStanding: 0
      Jumped: 0
  - Instruction: 'He jumps.

      Press <color=#FFD040>SPACE</color> to jump!'
    InstructionRu: "\u041E\u043D \u043F\u0440\u044B\u0433\u0430\u0435\u0442.\n\u041D\u0430\u0436\u043C\u0438
      <color=#FFD040>\u041F\u0420\u041E\u0411\u0415\u041B</color>, \u0447\u0442\u043E\u0431\u044B
      \u043F\u0440\u044B\u0433\u043D\u0443\u0442\u044C!"
    Mode: 0
    Pose:
      RightHandIsUp: 0
      LeftHandIsUp: 0
      IsStanding: 1
      Jumped: 1
  - Instruction: 'Crouch with a hand up.

      Hold <color=#FFD040>S</color> + <color=#FFD040>A</color>'
    InstructionRu: "\u041F\u0440\u0438\u0441\u044F\u0434\u044C \u0441 \u043F\u043E\u0434\u043D\u044F\u0442\u043E\u0439
      \u0440\u0443\u043A\u043E\u0439.\n\u0417\u0430\u0436\u043C\u0438 <color=#FFD040>S</color>
      + <color=#FFD040>A</color>"
    Mode: 0
    Pose:
      RightHandIsUp: 0
      LeftHandIsUp: 1
      IsStanding: 0
      Jumped: 0
  - Instruction: 'REVERSE: do the opposite!

      He stands with one hand up -

      hold
      <color=#FFD040>D</color> + <color=#FFD040>S</color>'
    InstructionRu: "\u041D\u0410\u041E\u0411\u041E\u0420\u041E\u0422: \u0434\u0435\u043B\u0430\u0439
      \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u043F\u043E\u043B\u043E\u0436\u043D\u043E\u0435!\n\u041E\u043D
      \u0441\u0442\u043E\u0438\u0442 \u0441 \u043F\u043E\u0434\u043D\u044F\u0442\u043E\u0439
      \u0440\u0443\u043A\u043E\u0439 -\n\u0437\u0430\u0436\u043C\u0438 <color=#FFD040>D</color>
      + <color=#FFD040>S</color>"
    Mode: 1
    Pose:
      RightHandIsUp: 0
      LeftHandIsUp: 1
      IsStanding: 1
      Jumped: 0
  - Instruction: 'Opposite again!

      He crouches with hands down -

      stand
      and hold <color=#FFD040>A</color> + <color=#FFD040>D</color>'
    InstructionRu: "\u0421\u043D\u043E\u0432\u0430 \u043D\u0430\u043E\u0431\u043E\u0440\u043E\u0442!\n\u041E\u043D
      \u0441\u0438\u0434\u0438\u0442 \u0441 \u043E\u043F\u0443\u0449\u0435\u043D\u043D\u044B\u043C\u0438
      \u0440\u0443\u043A\u0430\u043C\u0438 -\n\u0432\u0441\u0442\u0430\u043D\u044C
      \u0438 \u0437\u0430\u0436\u043C\u0438 <color=#FFD040>A</color> + <color=#FFD040>D</color>"
    Mode: 1
    Pose:
      RightHandIsUp: 0
      LeftHandIsUp: 0
      IsStanding: 0
      Jumped: 0
  - Instruction: 'He jumps - so you DON''T!

      Hold <color=#FFD040>A</color>
      + <color=#FFD040>D</color>, no jumping'
    InstructionRu: "\u041E\u043D \u043F\u0440\u044B\u0433\u0430\u0435\u0442 - \u0430
      \u0442\u044B \u041D\u0415\u0422!\n\u0417\u0430\u0436\u043C\u0438 <color=#FFD040>A</color>
      + <color=#FFD040>D</color> \u0438 \u043D\u0435 \u043F\u0440\u044B\u0433\u0430\u0439"
    Mode: 1
    Pose:
      RightHandIsUp: 0
      LeftHandIsUp: 0
      IsStanding: 1
      Jumped: 1
